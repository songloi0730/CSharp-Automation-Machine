<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Nút của màn hình vận hành, mục 10.2.7b: có phản hồi nhấn, có trạng thái làm mờ.
         Tag="DangNhan" chỉ để dựng được ảnh trạng thái đang nhấn cho sách. -->
    <Style x:Key="NutThuong" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="#3A3A3A"/>
        <Setter Property="BorderBrush" Value="#5A5A5A"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="20,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Khung" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <ContentPresenter x:Name="NoiDung" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Khung" Property="Background" Value="#1A1A1A"/>
                            <Setter TargetName="NoiDung" Property="RenderTransform">
                                <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="Tag" Value="DangNhan">
                            <Setter TargetName="Khung" Property="Background" Value="#1A1A1A"/>
                            <Setter TargetName="NoiDung" Property="RenderTransform">
                                <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Khung" Property="Background" Value="#262626"/>
                            <Setter TargetName="Khung" Property="BorderBrush" Value="#333333"/>
                            <Setter Property="Foreground" Value="#6E6E6E"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mỗi màn hình chỉ một, nhiều nhất hai nút nổi bật: phân biệt bằng kiểu, không bằng kích thước -->
    <Style x:Key="NutChinh" TargetType="Button" BasedOn="{StaticResource NutThuong}">
        <Setter Property="Background" Value="#2E6DA4"/>
        <Setter Property="BorderBrush" Value="#4D8CC4"/>
    </Style>

    <!-- Nút Dừng phần mềm không phải E-Stop nên không dùng đỏ (Bảng 10.2a).
         Nó nổi bật nhờ nền sáng duy nhất trên màn hình và vị trí cố định ở góc phải dưới. -->
    <Style x:Key="NutDung" TargetType="Button" BasedOn="{StaticResource NutThuong}">
        <Setter Property="Background" Value="#E6E6E6"/>
        <Setter Property="BorderBrush" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#111111"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OPhim" TargetType="Border">
        <Setter Property="Background" Value="#2A2A2A"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

</ResourceDictionary>
