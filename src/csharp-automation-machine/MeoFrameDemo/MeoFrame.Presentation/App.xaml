<Application x:Class="MeoFrame.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MeoFrame.Presentation.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Typography.xaml"/>
                <ResourceDictionary Source="Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:SeverityToBrushConverter   x:Key="SeverityToBrushConverter"/>
            <conv:ConnectionToBrushConverter x:Key="ConnectionToBrushConverter"/>
            <conv:ConnectionToTextConverter  x:Key="ConnectionToTextConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
