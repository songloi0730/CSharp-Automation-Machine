<UserControl x:Class="MeoFrame.Presentation.Views.ConnectionChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Code 10.2e, Chương 10: mỗi nguồn thiết bị một chip -->
    <Border CornerRadius="10" Padding="8,4" Background="{StaticResource BrushSurface}">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                     Fill="{Binding State, Converter={StaticResource ConnectionToBrushConverter}}"/>
            <TextBlock Margin="6,0,0,0" Foreground="{StaticResource BrushTextSecondary}" FontFamily="Segoe UI"
                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Run Text="{Binding Name, Mode=OneWay}"/><Run Text=": "/>
            </TextBlock>
            <TextBlock Foreground="{StaticResource BrushTextPrimary}" FontFamily="Segoe UI"
                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Text="{Binding State, Converter={StaticResource ConnectionToTextConverter}}"/>
        </StackPanel>
    </Border>
</UserControl>
